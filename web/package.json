{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/generate-catalog.mjs --check",
    "predev": "npm run catalog:generate",
    "dev": "vite",
    "prebuild": "npm run catalog:generate",
    "build": "tsc -b && vite build",
    "prelint": "npm run catalog:check",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "pretypecheck": "npm run catalog:check",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "pretest": "npm run catalog:check",
    "test": "NODE_OPTIONS=--import=./tests/assets-loader.mjs tsx --tsconfig tsconfig.app.json --test tests/document.test.ts tests/project-generator.test.ts tests/project-theme.test.ts tests/project-revisions.test.ts tests/published-theme.test.ts tests/organization-selection.test.ts tests/organization-permissions.test.ts tests/shadcn-space-conversion.test.ts tests/blocks-so-conversion.test.mjs tests/use-infinite-page.test.ts"
  },
  "dependencies": {
