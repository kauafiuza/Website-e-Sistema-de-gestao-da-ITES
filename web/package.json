    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-infinite-scroll-component": "^7.2.1",
    "react-resizable-panels": "^4.14.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.4",
